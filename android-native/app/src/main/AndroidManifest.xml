<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.RentedApp">
        <activity
            android:name=".ui.room.RoomDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".ui.room.PostRoomActivity"
            android:exported="false" />
        <activity
            android:name=".ui.room.MyRoomsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.appointment.AppointmentsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.rental.RentalRequestsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.contract.ContractsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.contract.ContractDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.invoice.InvoicesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.invoice.InvoiceDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.invoice.CreateInvoiceActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.auth.RegisterActivity" />
        <activity android:name=".MainActivity" />
    </application>

</manifest>
